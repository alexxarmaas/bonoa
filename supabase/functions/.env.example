# Supabase Edge Function secrets for register-with-email.
# Set these in Supabase Dashboard > Edge Functions > Secrets.
# Do not expose them as NEXT_PUBLIC_* variables and never commit real credentials.

BONOA_SMTP_HOST=authsmtp.securemail.pro
BONOA_SMTP_PORT=465
BONOA_SMTP_USER=your-mailbox@tramassso.com
BONOA_SMTP_PASSWORD=your-mailbox-password
BONOA_SMTP_FROM_NAME=Bonōa
