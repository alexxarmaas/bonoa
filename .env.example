NEXT_PUBLIC_SUPABASE_URL=https://dssxekvsmrlpkoqtgtmw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Tramassso remains an external showcase / discovery channel only.
NEXT_PUBLIC_TRAMASSSO_URL=https://www.tramassso.com

# Optional fixed canonical URL. Vercel previews use VERCEL_URL automatically.
BONOA_APP_URL=https://bonoa.vercel.app

# Google Wallet (server-side only). Create an issuer and authorize this service account.
GOOGLE_WALLET_ISSUER_ID=your_issuer_id
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet-service-account@project.iam.gserviceaccount.com
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Apple Wallet. The signer must return a signed application/vnd.apple.pkpass bundle.
# Keep Pass Type certificates/private keys in the signer, never NEXT_PUBLIC_* variables.
APPLE_WALLET_SIGNER_URL=https://wallet-signer.example.com/apple/pass
APPLE_WALLET_SIGNER_TOKEN=your_server_to_server_secret
